acl LAN {
    192.168.1.0/24;
    172.16.0.0/12;
    127.0.0.1;
};

options {
    directory "/var/cache/bind";
    listen-on { any; };
    listen-on-v6 { any; };

    allow-query { LAN; };
    allow-recursion { LAN; };
    allow-transfer { none; };
    allow-update { none; };

    forwarders {
        1.1.1.1;
        8.8.8.8;
    };
    recursion yes;

    dnssec-validation auto;

    version "not available";
    minimal-responses yes;
    max-cache-size 512M;

    //  statistics-file et zone-statistics DANS options
    statistics-file "/var/cache/bind/named.stats";
    zone-statistics yes;

    // RRL
    rate-limit {
        responses-per-second 5;
        window 5;
        slip 2;
        errors-per-second 5;
        all-per-second 20;
        log-only no;
        exempt-clients {
            127.0.0.1;
            172.16.0.0/12;
            192.168.1.0/24;
        };
    };
};

controls {
    inet 0.0.0.0 port 953 allow { 172.16.0.0/12; } keys { "rndc-key"; };
};

statistics-channels {
    inet 0.0.0.0 port 8053 allow { 172.16.0.0/12; 127.0.0.1; };
};

logging {
    channel default_log {
        file "/var/log/named/named.log" versions 5 size 20m;
        print-time yes;
        print-severity yes;
        print-category yes;
        severity info;
    };
    category default { default_log; };
    category rate-limit { default_log; };
};