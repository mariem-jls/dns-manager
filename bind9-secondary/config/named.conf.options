options {
    directory "/var/cache/bind";
    listen-on { any; };
    listen-on-v6 { any; };
    allow-query { any; };
    allow-recursion { any; };
    allow-transfer { none; };
    allow-update { none; };
    forwarders { 1.1.1.1; 8.8.8.8; };
    recursion yes;
    dnssec-validation auto;
    version "not available";
};