acl LAN {
    192.168.1.0/24;      // Réseau Wi-Fi
    172.16.0.0/12;       // Toute la plage Docker (172.16 → 172.31)
    127.0.0.1;
};

options {
    directory "/var/cache/bind";
    listen-on { any; };
    listen-on-v6 { any; };

    allow-query { LAN; };
    allow-recursion { LAN; };
    allow-transfer { none; };
    allow-update { none; };

    forwarders {
        1.1.1.1;
        8.8.8.8;
    };
    recursion yes;

    dnssec-validation auto;

    version "not available";
    minimal-responses yes;
    max-cache-size 256M;
};
statistics-channels {
        inet 0.0.0.0 port 8053 allow { 172.16.0.0/12; 127.0.0.1; };
    };