acl LAN {
    192.168.1.0/24;      // Réseau Wi-Fi
    172.16.0.0/12;       // Toute la plage Docker (172.16 → 172.31)
    127.0.0.1;
};

options {
    directory "/var/cache/bind";
    listen-on { any; };
    listen-on-v6 { any; };

    allow-query { LAN; };
    allow-recursion { LAN; };
    allow-transfer { none; };
    allow-update { none; };

    forwarders {
        1.1.1.1;
        8.8.8.8;
    };
    recursion yes;

    dnssec-validation auto;

    version "not available";
    minimal-responses yes;
    max-cache-size 256M;

    // ============================================
    // Statistics (DANS options)
    // ============================================
    statistics-file "/var/cache/bind/named.stats";
    zone-statistics yes;

    // ============================================
    // Response Rate Limiting (RRL)
    // ============================================
    rate-limit {
        responses-per-second 5;
        window 5;
        slip 2;
        errors-per-second 5;
        all-per-second 20;
        log-only no;
        exempt-clients {
            127.0.0.1;
            172.16.0.0/12;
            192.168.1.0/24;
        };
    };
};