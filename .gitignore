# ============================================
# FICHIERS SENSIBLES
# ============================================
.env
*.env
.env.*
!.env.example
*.key
*.pem
secrets/

# ============================================
# DOCKER / DATA PERSISTANTES
# ============================================
*.log
*.pid
/data/
/postgres/data/
/bind9/cache/
/bind9/logs/
/bind9-secondary/cache/
/bind9-secondary/logs/
/prometheus/data/
/grafana/data/
/grafana/plugins/
/wazuh/

# ============================================
# BIND9 (runtime + secrets)
# ============================================
bind9/config/tsig.key
bind9-secondary/config/tsig.key
bind9/config/rndc.key
bind9-secondary/config/rndc.key

# Fichiers runtime BIND (owned by bind user)
bind9/zones/*.jnl
bind9/zones/K*
bind9/zones/db-*
bind9-secondary/zones/*.jnl
bind9-secondary/zones/K*
bind9-secondary/zones/db-*

# ============================================
# TRAEFIK (certificats)
# ============================================
traefik/certs/*.key
traefik/certs/*.crt

# ============================================
# BACKEND (Python)
# ============================================
__pycache__/
*.pyc
*.pyo
*.pyd
venv/
.venv/
backend/logs/*
!backend/logs/.gitkeep

# ============================================
# FRONTEND (Node)
# ============================================
node_modules/
dist/
build/
.vite/
frontend/dist/

# ============================================
# ANSIBLE
# ============================================
ansible/*.retry
ansible/inventory/hosts.local


docker-compose.override.yml
docker-compose.*.bak


.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db